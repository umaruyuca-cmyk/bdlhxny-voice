# 环境变量文件
.env
deploy/.env
deploy/.env.cloud

# 构建产物
target/
dist/
deploy/packages/
*.zip
*.tgz
*.jar

# Python 运行与测试缓存
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
engine/artifacts/
# var 下运行产物忽略,但冻结 Session 用例数据(fixed cases)入库
engine/var/*
!engine/var/cases/

# Skill本地依赖、IDE文件和历史分析记录
skills/**/node_modules/
skills/**/.idea/
skills/**/history/
skills/**/portfolio.json

# IDE
.idea/
*.iml
.vscode/
.claude/

# 日志
*.log

# 演示彩排录屏（WO-T4-3：归档不入库）
/recordings/
*.mp4
*.webm
*.mkv

# Agent 工具本地状态（不提交）
.workbuddy-ai/
.workbuddy/
.zcode/

# Python 打包产物
*.egg-info/

# 实验任务持久化目录(运行时产物)
engine/var/jobs/
# Node 依赖(任何层级;web/ 维护自己的 package.json 与锁文件)
node_modules/

# 本地服务启动脚本(含密钥,不入库)
.local-services/
