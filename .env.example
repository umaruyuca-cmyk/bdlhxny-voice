# ============================================================
# StockWise 环境变量配置
# 复制此文件为 .env 并填写实际值
# ============================================================

# ──── 数据库（容器访问宿主机服务时使用 host.docker.internal）────
PG_URL=jdbc:postgresql://host.docker.internal:5432/stockwise
PG_USER=stockwise
PG_PASSWORD=请在此填入强密码
MYSQL_URL=jdbc:mysql://host.docker.internal:3306/appdb?useUnicode=true&characterEncoding=utf8mb4&useSSL=false&serverTimezone=Asia/Shanghai
MYSQL_USER=root
MYSQL_PASSWORD=请在此填写MySQL密码

# ──── Redis ────
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ──── DeepSeek API（深度推理模型）───
DEEPSEEK_API_KEY=sk-请在此填入你的DeepSeek_API_Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_ROUTER_ENABLED=true
DEEPSEEK_ROUTER_MODEL=deepseek-v4-flash
DEEPSEEK_ROUTER_MAX_TOKENS=256
DEEPSEEK_ROUTER_TIMEOUT_MS=2500
DEEPSEEK_ROUTER_MAX_CONCURRENCY=8

# ──── Ollama 本地模型（qwen3:1.5b 分类 + qwen3-embedding:0.6b 向量）───
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ──── 有界 ReAct 全局上限 ────
STOCKWISE_SINGLE_USER_ID=1
LEGACY_STOCK_AGENT_ENABLED=false
AGENT_CORE_THREADS=4
AGENT_MAX_THREADS=16
AGENT_QUEUE_CAPACITY=100
REACT_TOOL_CORE_THREADS=4
REACT_TOOL_MAX_THREADS=8
REACT_TOOL_QUEUE_CAPACITY=64
REACT_MAX_STEPS=5
REACT_DEADLINE_MS=180000
REACT_TOOL_TIMEOUT_MS=60000
REACT_MAX_SAME_ACTION=1
REACT_MAX_OBSERVATION_CHARS=8000

# ──── stock-wrapper 内部调用 ────
STOCK_WRAPPER_URL=http://stock-wrapper:3001
STOCK_WRAPPER_TOKEN=请在此填入随机字符串至少32位
STOCK_SKILL_TIMEOUT_MS=120000
STOCK_WRAPPER_MAX_CONCURRENCY=4

# ──── web-search-wrapper 多 Agent 共享搜索 ────
# WEB_SEARCH_AGENTS_JSON 保存 Wrapper 允许的调用方；每个 Agent 应使用不同的至少32位 Token
WEB_SEARCH_ENDPOINT_URL=http://web-search-wrapper:3002/api/search
WEB_SEARCH_AGENTS_JSON={"stockwise":"请在此填入StockWise独立搜索Token至少32位"}
WEB_SEARCH_AGENT_ID=stockwise
WEB_SEARCH_AGENT_TOKEN=请填写与WEB_SEARCH_AGENTS_JSON中stockwise一致的Token
WEB_SEARCH_TIMEOUT_MS=10000
WEB_SEARCH_CACHE_TTL_MS=60000
WEB_SEARCH_RATE_LIMIT_PER_MINUTE=60
WEB_SEARCH_CIRCUIT_FAILURE_THRESHOLD=5
WEB_SEARCH_CIRCUIT_RESET_MS=30000
SEARXNG_SECRET=请在此填入SearXNG随机字符串至少32位
SEARXNG_ENGINES=baidu,360search

# ──── MCP 公网 HTTPS 入口（原始 8000/8083 端口仅监听回环）────
AKSHARE_ONE_MCP_ENDPOINT=https://akshare-mcp.bdlhxny.com/mcp
CN_FINANCIAL_MCP_ENDPOINT=https://cn-financial-mcp.bdlhxny.com/sse

# ──── JWT 签名密钥 ────
JWT_SECRET=请在此填入随机字符串至少32位
STOCKWISE_AUTH_REQUIRED=true

# ──── Python 与 Java 用户数据服务 ────
JAVA_API_BASE_URL=http://stockwise-backend:8080
# 两边必须使用同一个高强度内部令牌，但不能与 JWT_SECRET 共用。
JAVA_DATA_INTERNAL_TOKEN=请在此填入独立随机字符串至少32位
JAVA_DATA_REQUIRE_AUTHENTICATED=true
LEGACY_JAVA_AGENT_RUNTIME_ENABLED=false
