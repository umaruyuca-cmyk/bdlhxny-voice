# BDLH Agent Runtime 环境变量模板
# 复制为 deploy/.env 并填写实际值。.env 不要入库。
# 本文件是仓库内唯一 .env.example。

# ──── 数据库 ────
# 密码若含 @ # : / 等字符，POSTGRES_DSN 必须 URL 编码。
PG_USER=postgres
PG_PASSWORD=请在此填入强密码
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/bdlhRuntime
PG_URL=jdbc:postgresql://127.0.0.1:5432/bdlhRuntime
POSTGRES_DSN=postgresql://postgres:请在此填入强密码@127.0.0.1:5432/bdlhRuntime
BDLH_FLYWAY_ENABLED=true
BDLH_DB_MIN_IDLE=1
BDLH_DB_MAX_POOL_SIZE=8
BDLH_DB_CONNECTION_TIMEOUT_MS=3000
BDLH_DB_VALIDATION_TIMEOUT_MS=1000
BDLH_DB_LEAK_DETECTION_THRESHOLD_MS=0

# ──── Redis（缓存/限流，非真源）────
REDIS_HOST=127.0.0.1
REDIS_URL=redis://127.0.0.1:6379
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ──── 认证 ────
JWT_SECRET=请在此填入随机字符串至少32位
BDLH_RUNTIME_AUTH_REQUIRED=true

# ──── Python 运行 ────
BDLH_RUNTIME_ENV=production
BDLH_RUNTIME_CHECKPOINTER_BACKEND=postgres
# P2/P3 切流开关：改为 java 后 Chat/Run/History/Task/Outbox 均仅写 Java Data Plane；
# 必须同时配置 JAVA_API_BASE_URL 与 JAVA_DATA_INTERNAL_TOKEN，且先完成 migration、权限与回滚演练。
BDLH_RUNTIME_DATA_MODE=legacy
BDLH_COGNITIVE_ROLLOUT_MODE=off
BDLH_COGNITIVE_ROLLOUT_PERCENTAGE=0
BDLH_COGNITIVE_ROLLOUT_INTERNAL_USER_IDS=
BDLH_COGNITIVE_ROLLOUT_APPROVAL_REF=
BDLH_COGNITIVE_ROLLOUT_OWNER=
BDLH_COGNITIVE_ROLLBACK_OWNER=
BDLH_FINANCIAL_TASK_WORKER_ENABLED=false
BDLH_FINANCIAL_TASK_POLL_SECONDS=10
LEGACY_STOCK_AGENT_ENABLED=false
BDLH_RUNTIME_SINGLE_USER_ID=1

# ──── Python ↔ Java 用户数据 ────
# 同机生产 Java 监听 127.0.0.1:8081；本地 compose 可用 http://bdlh-runtime-data:8080
JAVA_API_BASE_URL=http://127.0.0.1:8081
JAVA_DATA_INTERNAL_TOKEN=请在此填入独立随机字符串至少32位
JAVA_DATA_REQUIRE_AUTHENTICATED=true
# ──── RocketMQ P4（单节点、单副本、仅 Docker 内网；并非 HA）────
# 启用前先确保 BDLH_RUNTIME_DATA_MODE=java，并已完成 P1-P3 migration。
ROCKETMQ_ENABLED=false
ROCKETMQ_ENDPOINTS=rmq-broker:8081
ROCKETMQ_RELAY_FIXED_DELAY_MS=1000
ROCKETMQ_RELAY_BATCH_SIZE=50
# ──── Memory Service P5（L3 语义记忆，独立 role；不是 L4 用户画像）────
BDLH_MEMORY_MODE=noop
MEMORY_SERVICE_BASE_URL=http://bdlh-memory-service:8091
MEMORY_SERVICE_INTERNAL_TOKEN=请在此填入与JAVA_DATA_INTERNAL_TOKEN不同的随机字符串至少32位
MEMORY_POSTGRES_DSN=postgresql://bdlh_memory_service:请填密码@postgres:5432/bdlh
MEMORY_ROCKETMQ_ENABLED=false
# Production must provide a Mem0 pgvector configuration that uses the memory schema.
# Keep this as one JSON line; the exact provider options follow the pinned Mem0 version.
MEM0_CONFIG_JSON=
LEGACY_JAVA_AGENT_RUNTIME_ENABLED=false

# ──── 模型 ────
DEEPSEEK_API_KEY=sk-请在此填入你的DeepSeek_API_Key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ──── MCP ────
AKSHARE_ONE_MCP_ENDPOINT=https://akshare-mcp.bdlhxny.com/mcp
CN_FINANCIAL_MCP_ENDPOINT=https://cn-financial-mcp.bdlhxny.com/sse

# ──── Web Search ────
# Python 调 adapter :3002，不是 SearXNG :8080。
WEB_SEARCH_BASE_URL=http://127.0.0.1:3002
WEB_SEARCH_ENDPOINT_URL=https://bdlhxny.com/api/search
WEB_SEARCH_AGENT_ID=bdlh_runtime
WEB_SEARCH_AGENT_TOKEN=请填写与WEB_SEARCH_AGENTS_JSON中bdlh_runtime一致的Token至少32位
WEB_SEARCH_TOKEN=请填写与WEB_SEARCH_AGENT_TOKEN相同的值
WEB_SEARCH_AGENTS_JSON={"bdlh_runtime":"请在此填入BDLH Agent Runtime独立搜索Token至少32位"}
WEB_SEARCH_TIMEOUT_MS=10000
WEB_SEARCH_CACHE_TTL_MS=60000
WEB_SEARCH_RATE_LIMIT_PER_MINUTE=60
WEB_SEARCH_CIRCUIT_FAILURE_THRESHOLD=5
WEB_SEARCH_CIRCUIT_RESET_MS=30000
SEARXNG_SECRET=请在此填入SearXNG随机字符串至少32位
SEARXNG_ENGINES=baidu,360search
SEARXNG_URL=http://127.0.0.1:8080

# ──── Mem0（可选；失败降级为无记忆）────
MEM0_LLM_MODEL=deepseek-v4-flash
MEM0_EMBEDDER_MODEL=qwen3-embedding:0.6b
# 本地 Docker 桥接用 host.docker.internal；云端 host 网络用 127.0.0.1
QWEN3_BASE_URL=http://host.docker.internal:11434/v1
QWEN3_API_KEY=ollama
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
# 上述 MEM0/QWEN3/REDIS 需由 compose environment 注入容器，写在 .env 不会自动进进程。
