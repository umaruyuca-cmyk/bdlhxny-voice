# BDLH Agent Runtime 部署环境变量（复制为 .env 并填实际值）
# 此文件不含敏感信息，可入库；.env 不要入库

# PostgreSQL（云服务器已有的容器，端口映射到宿主机 5432）
DATABASE_URL=jdbc:postgresql://localhost:5432/bdlh_runtime
PG_USER=root
PG_PASSWORD=改成你的PG密码
POSTGRES_DSN=postgresql://root:改成你的PG密码@127.0.0.1:5432/bdlh_runtime

# Python Runtime 的 DeepSeek API
DEEPSEEK_API_KEY=sk-你的key

# 公网 HTTPS 入口（原始服务端口只允许回环/私网访问）
AKSHARE_ONE_MCP_ENDPOINT=https://akshare-mcp.bdlhxny.com/mcp
CN_FINANCIAL_MCP_ENDPOINT=https://cn-financial-mcp.bdlhxny.com/sse
WEB_SEARCH_ENDPOINT_URL=https://bdlhxny.com/api/search

# 用户身份与 Python -> Java 服务间认证
JWT_SECRET=请在此填入随机字符串至少32位
BDLH_RUNTIME_AUTH_REQUIRED=true
JAVA_API_BASE_URL=http://127.0.0.1:8081
JAVA_DATA_INTERNAL_TOKEN=请在此填入独立随机字符串至少32位
JAVA_DATA_REQUIRE_AUTHENTICATED=true
