# =============================================================================
# BDLH Agent Runtime —— 全项目唯一配置清单（模板）
# =============================================================================
# 用法：
#   1. 复制本文件为 deploy/.env
#   2. 按注释填写真实值（密钥、密码、Token 等）
#   3. 用 docker compose 启动时会自动读取 deploy/.env
#
# 规则：
#   - 本文件是仓库内唯一 .env 模板；真实 deploy/.env 不要入库
#   - 所有服务共用这一份清单；各服务只读取自己需要的键
#   - 键名保持稳定；改名必须同步改 compose 与各服务代码
#   - 注释中的「使用方」表示主要消费该键的服务
# =============================================================================


# -----------------------------------------------------------------------------
# 一、运行环境与身份认证
# -----------------------------------------------------------------------------

# 【使用方：全栈】运行环境：development / production
# production 会强制更严的鉴权与禁 mock 行为
BDLH_RUNTIME_ENV=production

# 【使用方：Java】Spring 激活配置档：dev / prod（与 BDLH_RUNTIME_ENV 配合）
# production 用 prod（需本机有 application-prod.yml）；本地联调可改 dev
SPRING_PROFILES_ACTIVE=prod

# 【使用方：Python】是否强制 JWT 鉴权：true / false
# false：允许访客直接对话（前端不再弹出登录遮罩）；true：接口强制登录
# production 对外暴露时建议 true；本地试用 / 未登录 GLM 可 false
BDLH_RUNTIME_AUTH_REQUIRED=false

# 【使用方：Python / Java】JWT 签名密钥，至少 32 位随机字符串，两端必须一致
JWT_SECRET=请在此填入随机字符串至少32位

# 【使用方：Java】JWT 过期天数
JWT_EXPIRATION_DAYS=7

# 【使用方：Java】单用户兜底 ID（仅开发/无鉴权降级场景；生产应走真实 JWT sub）
BDLH_RUNTIME_SINGLE_USER_ID=1

# 【使用方：Python】HTTP API 前缀（一般无需改）
BDLH_RUNTIME_API_PREFIX=/api/v1

# 【使用方：Python】SSE / 事件等待上限（秒）
BDLH_RUNTIME_MAX_EVENT_WAIT_SECONDS=30


# -----------------------------------------------------------------------------
# 二、PostgreSQL（业务 / Runtime / Registry；Java Data Plane 主库）
# -----------------------------------------------------------------------------

# 【使用方：Java】PostgreSQL 用户名
PG_USER=postgres

# 【使用方：Java】PostgreSQL 密码（请换成强密码）
PG_PASSWORD=请在此填入强密码

# 【使用方：Java】PostgreSQL JDBC URL（Compose 内可用主机名 postgres）
# 本机直连示例：jdbc:postgresql://127.0.0.1:5432/bdlhRuntime
PG_URL=jdbc:postgresql://127.0.0.1:5432/bdlhRuntime

# 【使用方：Java / 兼容旧名】与 PG_URL 同义时可保持一致
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/bdlhRuntime

# 【使用方：Java】连接池最小空闲连接数
BDLH_DB_MIN_IDLE=1

# 【使用方：Java】连接池最大连接数
BDLH_DB_MAX_POOL_SIZE=8

# 【使用方：Java】获取连接超时（毫秒）
BDLH_DB_CONNECTION_TIMEOUT_MS=3000

# 【使用方：Java】连接校验超时（毫秒）
BDLH_DB_VALIDATION_TIMEOUT_MS=1000

# 【使用方：Java】连接泄漏检测阈值（毫秒）；0 表示关闭
BDLH_DB_LEAK_DETECTION_THRESHOLD_MS=0


# -----------------------------------------------------------------------------
# 三、MySQL（身份 / 历史用户库；由 Java 封装，勿让 Python 直连）
# -----------------------------------------------------------------------------

# 【使用方：Java】MySQL JDBC URL
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/platform?useUnicode=true&characterEncoding=UTF-8&useSSL=false&serverTimezone=Asia/Shanghai

# 【使用方：Java】MySQL 用户名
MYSQL_USER=请填写MySQL用户名

# 【使用方：Java】MySQL 密码
MYSQL_PASSWORD=请填写MySQL密码


# -----------------------------------------------------------------------------
# 四、Redis（可选缓存 / 限流；不是业务真源）
# -----------------------------------------------------------------------------

# 【使用方：可选】Redis 主机
REDIS_HOST=127.0.0.1

# 【使用方：可选】Redis 端口
REDIS_PORT=6379

# 【使用方：可选】Redis 密码；无密码留空
REDIS_PASSWORD=

# 【使用方：可选】Redis DB 编号
REDIS_DATABASE=0

# 【使用方：Python 等】完整 Redis URL；为空表示不启用
REDIS_URL=redis://127.0.0.1:6379


# -----------------------------------------------------------------------------
# 五、Python Orchestrator ↔ Java Data Plane
# -----------------------------------------------------------------------------

# 【使用方：Python】Java Data Plane 基址
# Compose 内网：http://bdlh-runtime-data:8080
# 本机/云端 host 网络：http://127.0.0.1:8081
JAVA_API_BASE_URL=http://127.0.0.1:8081

# 【使用方：Python / Java】服务间内部令牌，至少 32 位；两端必须一致
JAVA_DATA_INTERNAL_TOKEN=请在此填入独立随机字符串至少32位

# 【使用方：Java】内部数据接口是否要求已认证身份；生产必须 true
JAVA_DATA_REQUIRE_AUTHENTICATED=true

# 已退役（勿再配置）：POSTGRES_DSN、BDLH_RUNTIME_CHECKPOINTER_BACKEND
# Chat/Run/History/Task 由 Java Data Plane 持久化；Registry 快照经 JAVA_API_* 拉取。


# -----------------------------------------------------------------------------
# 六、RocketMQ（异步消息；默认关闭，开启前需完成库表迁移）
# -----------------------------------------------------------------------------

# 【使用方：Java】是否启用 RocketMQ Outbox 中继：true / false
ROCKETMQ_ENABLED=false

# 【使用方：Java / Memory】Broker/Proxy 地址（Compose 内网示例）
ROCKETMQ_ENDPOINTS=rmq-broker:8081

# 【使用方：Java】Outbox 中继固定延迟（毫秒）
ROCKETMQ_RELAY_FIXED_DELAY_MS=1000

# 【使用方：Java】Outbox 每批拉取条数
ROCKETMQ_RELAY_BATCH_SIZE=50


# -----------------------------------------------------------------------------
# 七、Memory Service（L3 语义记忆；不是 L4 用户画像）
# -----------------------------------------------------------------------------

# 【使用方：Python】记忆模式：noop（关闭）/ remote（调独立 Memory 服务）/ embedded-test（仅非生产对照）
# 【使用方：Python Orchestrator】记忆模式：noop | remote
# 生产目标为 remote（G7）；本地未起 Memory Service 前保持 noop
# remote 时必须同时配置 MEMORY_SERVICE_* 与 Java Outbox 凭证
BDLH_MEMORY_MODE=noop

# 【使用方：Python】Memory Service 基址（Compose 内网示例）
MEMORY_SERVICE_BASE_URL=http://bdlh-memory-service:8091

# 【使用方：Python / Memory】Memory 服务内部令牌；必须与 JAVA_DATA_INTERNAL_TOKEN 不同
MEMORY_SERVICE_INTERNAL_TOKEN=请在此填入与JAVA_DATA_INTERNAL_TOKEN不同的随机字符串至少32位

# 【使用方：Memory】Memory 专用 PostgreSQL DSN（独立 role + memory schema）
MEMORY_POSTGRES_DSN=postgresql://bdlh_memory_service:请填密码@127.0.0.1:5432/bdlhRuntime

# 【使用方：Memory】Memory 是否消费 RocketMQ：true / false
# 仅当 BDLH_MEMORY_MODE=remote 时再开；noop 期间保持 false
MEMORY_ROCKETMQ_ENABLED=false

# 【使用方：Memory】Mem0 向量/存储配置（单行 JSON）；生产启用 remote 时必填
# 需指向 memory schema 的 pgvector 配置，具体字段以当前锁定的 Mem0 版本为准
MEM0_CONFIG_JSON=


# -----------------------------------------------------------------------------
# 八、大模型与嵌入（默认 GLM-4.7 / Qwen3 / Ollama）
# -----------------------------------------------------------------------------

# 【使用方：Python / Memory】LLM API Key（智谱开放平台）
# 优先读 LLM_API_KEY；未设置时回退 DEEPSEEK_API_KEY（兼容旧部署）
LLM_API_KEY=请在此填入你的智谱_API_Key
DEEPSEEK_API_KEY=

# 【使用方：Python / Memory】LLM API 基址（OpenAI 兼容）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DEEPSEEK_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 【使用方：Python / Memory】主模型名（编排 + Mem0 内部 LLM）
LLM_MODEL=glm-4.7
MEM0_LLM_MODEL=glm-4.7

# 【使用方：Memory / 可选】Mem0 嵌入模型名
MEM0_EMBEDDER_MODEL=qwen3-embedding:4b-q8_0

# 【使用方：Memory】Qwen3 / Ollama OpenAI 兼容基址
# 本地 Ollama 经 frp 内网穿透到云服务器回环；Memory Service 为裸 Python，直连 127.0.0.1
QWEN3_BASE_URL=http://127.0.0.1:11434/v1

# 【使用方：Memory / 可选】Qwen3 / Ollama API Key（本地 Ollama 常用 ollama）
QWEN3_API_KEY=ollama


# -----------------------------------------------------------------------------
# 九、金融 MCP 数据源
# -----------------------------------------------------------------------------

# 【使用方：Python】akshare-one MCP 传输：streamable_http（一般无需改）
AKSHARE_ONE_MCP_TRANSPORT=streamable_http

# 【使用方：Python】akshare-one MCP 端点（内对内回环直连）
# host 网络：http://127.0.0.1:8083/mcp；桥接容器：http://host.docker.internal:8083/mcp
AKSHARE_ONE_MCP_ENDPOINT=http://127.0.0.1:8083/mcp

# 【使用方：Python】akshare-one 调用超时（秒）
AKSHARE_ONE_MCP_TIMEOUT=20

# 【使用方：Python】cn-financial MCP 传输：sse（一般无需改）
CN_FINANCIAL_MCP_TRANSPORT=sse

# 【使用方：Python】cn-financial MCP 端点（内对内回环直连）
# host 网络：http://127.0.0.1:8000/sse；桥接容器：http://host.docker.internal:8000/sse
CN_FINANCIAL_MCP_ENDPOINT=http://127.0.0.1:8000/sse

# 【使用方：Python】cn-financial 调用超时（秒）
CN_FINANCIAL_MCP_TIMEOUT=20


# -----------------------------------------------------------------------------
# 十、Web Search Adapter + SearXNG
# -----------------------------------------------------------------------------

# 【使用方：Python】搜索适配器基址（调 adapter，不是直接调 SearXNG）
# Compose 内网：http://bdlh-web-search-adapter:3002
# 本机：http://127.0.0.1:3002
WEB_SEARCH_BASE_URL=http://127.0.0.1:3002

# 【使用方：文档/网关】对外搜索入口 URL（若经公网 Nginx 暴露）
WEB_SEARCH_ENDPOINT_URL=https://bdlhxny.com/api/search

# 【使用方：Python】调用适配器时使用的 Agent ID（对应 WEB_SEARCH_AGENTS_JSON 的键）
WEB_SEARCH_AGENT_ID=bdlh_runtime

# 【使用方：Python】调用适配器时使用的搜索 Token（须与下方 JSON 中同名 Agent 的值一致）
WEB_SEARCH_TOKEN=请填写与WEB_SEARCH_AGENTS_JSON中bdlh_runtime一致的Token至少32位

# 【使用方：Compose 兼容别名】与 WEB_SEARCH_TOKEN 保持相同值
WEB_SEARCH_AGENT_TOKEN=请填写与WEB_SEARCH_TOKEN相同的值

# 【使用方：Web Search Adapter】允许访问的 Agent→Token 映射（JSON 单行）
WEB_SEARCH_AGENTS_JSON={"bdlh_runtime":"请在此填入BDLH Agent Runtime独立搜索Token至少32位"}

# 【使用方：Python】搜索 HTTP 超时（秒）
WEB_SEARCH_TIMEOUT=20

# 【使用方：Adapter】请求超时（毫秒）
WEB_SEARCH_TIMEOUT_MS=10000

# 【使用方：Adapter】结果缓存 TTL（毫秒）
WEB_SEARCH_CACHE_TTL_MS=60000

# 【使用方：Adapter】每分钟限流次数
WEB_SEARCH_RATE_LIMIT_PER_MINUTE=60

# 【使用方：Adapter】熔断失败次数阈值
WEB_SEARCH_CIRCUIT_FAILURE_THRESHOLD=5

# 【使用方：Adapter】熔断恢复等待（毫秒）
WEB_SEARCH_CIRCUIT_RESET_MS=30000

# 【使用方：Adapter】请求体最大字节数
WEB_SEARCH_MAX_BODY_BYTES=32768

# 【使用方：Adapter】单次最多搜索任务数
WEB_SEARCH_MAX_TASKS=3

# 【使用方：Adapter】每个任务最多返回结果数
WEB_SEARCH_MAX_RESULTS=5

# 【使用方：Adapter】监听端口（Compose 内一般为 3002）
PORT=3002

# 【使用方：Adapter】SearXNG 内网地址
# Compose：http://searxng:8080 ；本机：http://127.0.0.1:8080
SEARXNG_URL=http://127.0.0.1:8080

# 【使用方：SearXNG / Adapter】启用的搜索引擎列表（逗号分隔）
SEARXNG_ENGINES=baidu,360search

# 【使用方：SearXNG】实例密钥，至少 32 位随机字符串
SEARXNG_SECRET=请在此填入SearXNG随机字符串至少32位

# 【使用方：SearXNG】容器内对外声明的 Base URL（Compose 示例）
SEARXNG_BASE_URL=http://searxng:8080/


# -----------------------------------------------------------------------------
# 十一、Deep Research（ADR-016；默认关闭，不影响浅搜）
# -----------------------------------------------------------------------------

# 【使用方：Python】是否启用 Deep Research 固定复合工具：true / false
BDLH_DEEP_RESEARCH_ENABLED=false

# 【使用方：Python】阿里云百炼 / DashScope WebSearch API Key（启用 Deep 时需要）
BDLH_BAILIAN_WEB_SEARCH_API_KEY=

# 【使用方：Python】兼容别名：未设 BDLH_BAILIAN_WEB_SEARCH_API_KEY 时可填此键
DASHSCOPE_API_KEY=

# 【使用方：Python】百炼 WebSearch 端点；留空则用代码默认
BDLH_BAILIAN_WEB_SEARCH_ENDPOINT=

# 【使用方：Python】百炼 WebSearch 超时（秒）
BDLH_BAILIAN_WEB_SEARCH_TIMEOUT=20

# 【使用方：Python】百炼 WebSearch 每分钟限流
BDLH_BAILIAN_WEB_SEARCH_RATE_LIMIT_PER_MINUTE=30


# -----------------------------------------------------------------------------
# 十二、持续任务 Worker（M6；默认关闭）
# -----------------------------------------------------------------------------

# 【使用方：Python】是否启动金融观察任务 Worker：true / false
BDLH_FINANCIAL_TASK_WORKER_ENABLED=false

# 【使用方：Python】Worker 轮询间隔（秒）
BDLH_FINANCIAL_TASK_POLL_SECONDS=10


# -----------------------------------------------------------------------------
# 十三、云端进程绑定（仅 docker-compose.cloud.yml / 本机 host 网络常用）
# -----------------------------------------------------------------------------

# 【使用方：Java 云端】监听地址；云端建议 127.0.0.1，只给同机 Nginx 访问
SERVER_ADDRESS=127.0.0.1

# 【使用方：Java 云端】监听端口（云端常为 8081）
SERVER_PORT=8081


# =============================================================================
# 填写检查清单（复制为 .env 后请逐项确认）
# =============================================================================
# [ ] JWT_SECRET / JAVA_DATA_INTERNAL_TOKEN / MEMORY_SERVICE_INTERNAL_TOKEN 三者互不相同且足够长
# [ ] PG_PASSWORD / MYSQL_PASSWORD / MEMORY_POSTGRES_DSN 密码已替换
# [ ] LLM_API_KEY 已填写（智谱 GLM-4.7）
# [ ] WEB_SEARCH_TOKEN == WEB_SEARCH_AGENT_TOKEN == WEB_SEARCH_AGENTS_JSON.bdlh_runtime
# [ ] SEARXNG_SECRET 已填写
# [ ] Compose 内网部署时：把 JAVA_API_BASE_URL / WEB_SEARCH_BASE_URL / MEMORY_* / PG_URL 改成容器主机名
# [ ] 需要记忆时：BDLH_MEMORY_MODE=remote 且填好 MEMORY_* 与 MEM0_CONFIG_JSON
# [ ] 需要消息时：ROCKETMQ_ENABLED=true（并确认迁移与 Broker 已就绪）
# [ ] 需要 Deep Research 时：BDLH_DEEP_RESEARCH_ENABLED=true 并配置百炼 Key
# =============================================================================
