POSTGRES_DB=touchstone
POSTGRES_USER=touchstone
POSTGRES_PASSWORD=replace-with-a-strong-database-password

DATA_INTERNAL_TOKEN=replace-with-a-random-internal-token
# 本地默认 data 服务地址(容器部署由 compose 的 environment 显式覆盖)
DATA_API_BASE_URL=http://127.0.0.1:18081/internal/v1

# Token 计数口径:不设=保守估算(CJK 1 token);tiktoken=cl100k 近似;qwen=Qwen 官方词表精确
# (qwen 需先执行:cd engine && .venv/Scripts/python -m bdlh_runtime.context.token_count --init-qwen)
# LLM_TOKENIZER=qwen
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=Qwen/Qwen3.6-35B-A3B
GIT_COMMIT=local
MAX_CONCURRENT_BATCHES=1
# /lab 页面跨端口调用运行 API 的来源（私有部署按 CONSOLE 绑定填写；留空=禁用 CORS，公开部署留空）
RUN_API_ALLOWED_ORIGINS=

ENGINE_PORT=8090
CONSOLE_BIND=127.0.0.1
CONSOLE_PORT=8082

# ── 两类实验(压缩用例/对比用例)与匿名测试 ──
# 单次 Agent 运行最大步数(模型判断+工具回传);与重复次数 repeat_count 无关
MAX_AGENT_STEPS=8
# 匿名测试任务持久化目录(engine 侧文件存储;数据库结构见 db/postgresql/changes/)
JOBS_DIR=
# 匿名限额(服务端真源,前端只显示)
PUBLIC_MAX_CONCURRENT_JOBS_PER_ANON=1
PUBLIC_DAILY_JOBS_PER_ANON=10
PUBLIC_COMPARISON_DAILY_JOBS=10
PUBLIC_COMPRESSION_CONTEXT_DAILY_JOBS=5
PUBLIC_COMPRESSION_MATRIX_DAILY_JOBS=1
PUBLIC_QUEUE_TIMEOUT_S=120
PUBLIC_MATRIX_QUEUE_TIMEOUT_S=300
PUBLIC_MAX_JOB_DURATION_S=900
PUBLIC_MATRIX_MAX_JOB_DURATION_S=300
