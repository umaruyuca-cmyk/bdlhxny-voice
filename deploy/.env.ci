# CI 专用固定环境（compose 校验不依赖宿主机真实密钥）。
# 仅用于 docker compose config / 测试；全部为占位值，不含任何真实密钥。
# 键集合与 deploy/.env.example 对齐，便于同一清单演进。

# ──── 运行环境与认证 ────
BDLH_RUNTIME_ENV=development
BDLH_RUNTIME_AUTH_REQUIRED=true
JWT_SECRET=ci-placeholder-jwt-secret-0123456789abcdef0123456789abcdef
JWT_EXPIRATION_DAYS=7
BDLH_RUNTIME_SINGLE_USER_ID=1

# ──── PostgreSQL / MySQL ────
PG_USER=postgres
PG_PASSWORD=ci-placeholder-password
PG_URL=jdbc:postgresql://postgres:5432/bdlhRuntime
DATABASE_URL=jdbc:postgresql://postgres:5432/bdlhRuntime
MYSQL_USER=ci_user
MYSQL_PASSWORD=ci-placeholder-password
MYSQL_URL=jdbc:mysql://mysql:3306/bdlh_ci

# ──── Python ↔ Java / Memory ────
JAVA_API_BASE_URL=http://bdlh-runtime-data:8080
JAVA_DATA_INTERNAL_TOKEN=ci-placeholder-internal-token-0123456789abcdef
JAVA_DATA_REQUIRE_AUTHENTICATED=true
MEMORY_SERVICE_INTERNAL_TOKEN=ci-placeholder-memory-token-0123456789abcdef
MEMORY_POSTGRES_DSN=postgresql://bdlh_memory_service:ci-placeholder-password@postgres:5432/bdlhRuntime
BDLH_MEMORY_MODE=remote

# ──── 模型 / 搜索 ────
LLM_API_KEY=ci-placeholder-glm-key
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.7
DEEPSEEK_API_KEY=ci-placeholder-glm-key
DEEPSEEK_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MEM0_LLM_MODEL=glm-4.7
WEB_SEARCH_TOKEN=ci-placeholder-search-token
WEB_SEARCH_AGENT_TOKEN=ci-placeholder-search-token
WEB_SEARCH_AGENTS_JSON={"bdlh_runtime":"ci-placeholder-search-token"}
SEARXNG_SECRET=ci-placeholder-searxng-secret
SEARXNG_URL=http://searxng:8080
