{
  "name": "@stockwise/stock-analysis-skill",
  "version": "1.1.1",
  "description": "StockWise 的可审计 A股、ETF、基金与持仓分析 NPM Skill。",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "stock-analysis": "./bin/stock-analysis.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./contract": "./src/output/json-contract.js"
  },
  "files": [
    "bin/",
    "src/",
    "agents/",
    "references/",
    "templates/",
    "SKILL.md"
  ],
  "scripts": {
    "start": "node bin/stock-analysis.js",
    "sector": "node bin/stock-analysis.js sector",
    "portfolio": "node bin/stock-analysis.js portfolio",
    "quant": "node bin/stock-analysis.js quant 510300 159915 512100",
    "test": "node --test",
    "test:contract": "node --test test/json-contract.test.js test/stock-json.test.js",
    "check": "node bin/stock-analysis.js --help && node bin/stock-analysis.js sector --json && node bin/stock-analysis.js portfolio --config templates/portfolio.example.json --json",
    "pack:verify": "npm pack --dry-run",
    "prepack": "npm test"
  },
  "keywords": [
    "a-share",
    "stock-analysis",
    "codex-skill",
    "claude-skill",
    "portfolio"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "1.18.1",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.2"
  }
}
