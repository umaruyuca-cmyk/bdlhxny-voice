<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="compare" name="同一句话两种走法">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="同一句话，两种走法：Route 定死路径 vs Agent 自己选下一步" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="80" y="20" width="1440" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="用户：「找出最近一个月半导体板块涨幅最高的五家，再判断它们和我的持仓是否存在产业链关系，同时分析最近新闻是否有共同催化。」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="60" width="1440" height="50" as="geometry" />
        </mxCell>

        <mxCell id="left" value="A. 收敛成业务 Route（智能被砍掉）" style="swimlane;startSize=36;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="130" width="680" height="920" as="geometry" />
        </mxCell>
        <mxCell id="right" value="B. 门控 + Agent 循环（自主性在这里）" style="swimlane;startSize=36;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="130" width="680" height="920" as="geometry" />
        </mxCell>

        <mxCell id="l1" value="必须先贴一个标签&#xa;STOCK_RESEARCH / PORTFOLIO / NEWS / ???" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="left">
          <mxGeometry x="160" y="50" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="选不出就卡住&#xa;或强行进 STOCK_RESEARCH" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="left">
          <mxGeometry x="180" y="150" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="固定剧本启动&#xa;该 Route 要求恰好 1 只股票" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="left">
          <mxGeometry x="160" y="280" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l4" value="Agent 没有下一步决策权&#xa;只能问：你想分析哪只股票？" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="left">
          <mxGeometry x="160" y="380" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l5" value="即使用户随便给一只&#xa;也只会研究这一只" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="left">
          <mxGeometry x="160" y="480" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l6" value="板块 Top5、持仓对照、共同新闻&#xa;全部做不了" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="left">
          <mxGeometry x="160" y="590" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="lnote" value="路径在用户开口时就定死了。&#xa;组合题只能靠继续加 Route 枚举。&#xa;这就是「显得不够智能」的原因。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;dashed=1;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="left">
          <mxGeometry x="80" y="710" width="520" height="80" as="geometry" />
        </mxCell>

        <mxCell id="le1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="left" source="l1" target="l2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="le2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="left" source="l2" target="l3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="le3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="left" source="l3" target="l4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="le4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="left" source="l4" target="l5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="le5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="left" source="l5" target="l6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="r1" value="门控（很快，不管研究怎么做）&#xa;只读？新问题？能力开了？" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="right">
          <mxGeometry x="160" y="50" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="理解目标（不贴业务标签）&#xa;Goal / 实体 / 约束" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="right">
          <mxGeometry x="160" y="150" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="Agent 决策：下一步做什么？" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="right">
          <mxGeometry x="160" y="250" width="360" height="56" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="调一个能力：行情 / 持仓 / 新闻 / 计算…" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="right">
          <mxGeometry x="160" y="336" width="360" height="56" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="看结果（Observation）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="right">
          <mxGeometry x="160" y="422" width="360" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="目标完成了吗？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="right">
          <mxGeometry x="200" y="500" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r7" value="综合回答&#xa;Top5 + 持仓关系 + 共同新闻" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="right">
          <mxGeometry x="160" y="620" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rnote" value="路径是做出来的，不是预先枚举的。&#xa;橙色门控只拦边界；紫色循环才是智能。&#xa;组合题不需要新 Route。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="right">
          <mxGeometry x="80" y="730" width="520" height="80" as="geometry" />
        </mxCell>

        <mxCell id="re1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="right" source="r1" target="r2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="right" source="r2" target="r3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="right" source="r3" target="r4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="right" source="r4" target="r5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="right" source="r5" target="r6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re6" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=12;" edge="1" parent="right" source="r6" target="r7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re7" value="否，再决策" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;fontSize=12;" edge="1" parent="right" source="r6" target="r3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="40" y="540" />
              <mxPoint x="40" y="278" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="example" name="组合题逐步展开">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="et" value="同一道组合题：Agent 自己走出的路径（没有预先写 Route）" style="text;html=1;fontSize=18;fontStyle=1;align=center;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="80" y="20" width="1440" height="36" as="geometry" />
        </mxCell>

        <mxCell id="goal" value="理解结果（不是 Route）&#xa;Goal：半导体近1月涨幅Top5 + 与持仓的产业链关系 + 共同新闻催化&#xa;实体：板块=半导体，时间=1个月，持仓=当前用户&#xa;约束：只读，不给「适不适合你」的结论" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="70" width="1440" height="90" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="第1步 Agent 自己选&#xa;查板块涨幅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="200" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="o1" value="观察&#xa;中芯 / 北方华创 /&#xa;海光 / 宁德 / 中微" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="300" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s2" value="第2步 Agent 自己选&#xa;拉用户持仓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="200" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="观察&#xa;持有宁德、比亚迪、&#xa;招商银行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="300" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s3" value="第3步 Agent 自己选&#xa;查产业链关系" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="200" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="o3" value="观察&#xa;宁德在榜且在持仓；&#xa;中芯与持仓无直接链" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="300" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s4" value="第4步 Agent 自己选&#xa;搜共同新闻" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="200" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="o4" value="观察&#xa;AI算力政策、&#xa;设备国产替代" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="300" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s5" value="第5步 Agent 自己判断&#xa;信息够了 → 回答" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="200" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="o5" value="回答覆盖三件事&#xa;Top5 / 产业链 / 催化" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="300" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s1" target="o1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="o1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s2" target="o2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="o2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s3" target="o3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="o3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s4" target="o4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="o4" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s5" target="o5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="gate" value="全程门控只做三件事，不替 Agent 选研究路径：&#xa;1. 全是只读查询，放行&#xa;2. 不涉及下单/改持仓，放行&#xa;3. 工具次数和超时有上限，防止死循环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="430" width="700" height="90" as="geometry" />
        </mxCell>
        <mxCell id="now" value="如果按现在的业务 Route：&#xa;进 STOCK_RESEARCH → 要求恰好 1 只股票 → 反问「你想分析哪只？」&#xa;用户会觉得系统很笨。笨的不是模型，是路径被提前锁死。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="430" width="700" height="90" as="geometry" />
        </mxCell>

        <mxCell id="simple" value="简单题仍然很短，自主 ≠ 每句都绕一大圈&#xa;「宁德时代现在多少钱？」→ 理解目标=查现价 → Agent 只调一次行情 → 够了就答。&#xa;智能体现在「它自己决定只走一步」，不是「必须多走几步才叫智能」。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="550" width="1440" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
