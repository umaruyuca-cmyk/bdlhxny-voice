{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "showcase-data run（单次运行公开工件）",
  "description": "按评测文档 §11.3 九段固定顺序组织；数量字段允许 null（未运行）。禁止字段见 schema/README.md。",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "batch_id", "case_id", "status", "validity", "experiment", "sections"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "batch_id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["COMPLETE", "FAILED", "INVALID", "CANCELLED", "PENDING_JUDGMENT", "NOT_RUN"] },
    "validity": { "enum": ["VALID", "INVALID", "UNCLASSIFIED"] },
    "started_at": { "type": "string", "description": "运行发生时间;旧版工件可能缺失,页面显示「未记录」" },
    "config_hash": { "type": "string", "description": "运行配置快照哈希(同配置必同哈希)" },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "description": "实际生效的运行配置(来自 provenance.per_run_config 白名单投影;旧版工件缺失)",
      "properties": {
        "config_version": { "type": ["integer", "null"] },
        "execution_engine": { "type": ["string", "null"] },
        "tool_delivery": { "type": ["string", "null"] },
        "governance_profile": { "type": ["string", "null"] },
        "context_strategy": { "type": ["string", "null"] },
        "fixture_version": { "type": ["string", "null"] },
        "prompt_version": { "type": ["string", "null"] },
        "judge_version": { "type": ["string", "null"] },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": { "type": ["string", "null"] },
            "model_id": { "type": ["string", "null"] },
            "temperature_requested": { "type": ["number", "null"] },
            "temperature_effective": { "type": ["number", "null"] },
            "top_p_requested": { "type": ["number", "null"] },
            "top_p_effective": { "type": ["number", "null"] },
            "reasoning_effort_requested": { "type": ["string", "null"] },
            "reasoning_effort_effective": { "type": ["string", "null"] },
            "seed_requested": { "type": ["integer", "null"] },
            "seed_effective": { "type": ["integer", "null"] },
            "max_output_tokens": { "type": ["integer", "null"] },
            "tool_choice": { "type": ["string", "null"] },
            "parallel_tool_calls": { "type": ["boolean", "null"] }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_agent_steps": { "type": ["integer", "null"] },
            "max_tool_calls": { "type": ["integer", "null"] },
            "max_calls_per_tool": { "type": ["integer", "null"] },
            "agent_timeout_seconds": { "type": ["integer", "null"] },
            "tool_timeout_seconds": { "type": ["integer", "null"] },
            "llm_retry_count": { "type": ["integer", "null"] },
            "tool_retry_count": { "type": ["integer", "null"] }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "token_budget": { "type": ["integer", "null"] },
            "recent_turn_count": { "type": ["integer", "null"] },
            "compression_target_tokens": { "type": ["integer", "null"] },
            "current_turn_reserved_tokens": { "type": ["integer", "null"] },
            "tokenizer_version": { "type": ["string", "null"] }
          }
        }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_mode", "model", "repeat_index"],
      "properties": {
        "agent_mode": { "enum": ["native-tool-calling"] },
        "context_strategy": { "enum": ["full", "recent-n", "single-summary", "budgeted", null] },
        "model": { "type": "string", "minLength": 1 },
        "repeat_index": { "type": "integer", "minimum": 1 }
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixed_input", "context", "visible_tools", "model_steps", "code_decisions", "tool_results", "output_checks", "final_result", "cost"],
      "properties": {
        "fixed_input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["message", "scene", "authenticated"],
          "properties": {
            "message": { "type": "string" },
            "scene": { "type": "string" },
            "authenticated": { "type": "boolean" },
            "history_count": { "type": "integer", "minimum": 0 },
            "allowed_tools": { "type": ["array", "null"], "items": { "type": "string" } }
          }
        },
        "context": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["strategy", "raw_tokens", "working_tokens", "required_retained", "item_counts"],
          "properties": {
            "strategy": { "type": "string" },
            "raw_tokens": { "type": ["integer", "null"] },
            "working_tokens": { "type": ["integer", "null"] },
            "required_retained": { "type": ["boolean", "null"] },
            "item_counts": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["retained", "compressed", "referenced", "isolated", "omitted"],
              "properties": {
                "retained": { "type": ["integer", "null"] },
                "compressed": { "type": ["integer", "null"] },
                "referenced": { "type": ["integer", "null"] },
                "isolated": { "type": ["integer", "null"] },
                "omitted": { "type": ["integer", "null"] }
              }
            }
          }
        },
        "visible_tools": { "type": ["array", "null"], "items": { "type": "string" } },
        "model_steps": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["seq", "decision"],
            "properties": {
              "seq": { "type": "integer", "minimum": 1 },
              "decision": { "type": "string" },
              "latency_ms": { "type": ["integer", "null"] }
            }
          }
        },
        "code_decisions": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["seq", "allowed"],
            "properties": {
              "seq": { "type": "integer", "minimum": 1 },
              "allowed": { "type": "boolean" },
              "audit_code": { "type": "string" }
            }
          }
        },
        "tool_results": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["seq", "name", "status"],
            "properties": {
              "seq": { "type": "integer", "minimum": 1 },
              "name": { "type": "string" },
              "status": { "type": "string" },
              "audit_code": { "type": "string" },
              "arguments": { "type": ["object", "null"], "description": "调用参数(模型所发请求;脱敏白名单内)" },
              "duration_ms": { "type": ["integer", "null"] },
              "summary": { "type": ["object", "null"] },
              "source": { "type": ["string", "null"] },
              "data_time": { "type": ["string", "null"] }
            }
          }
        },
        "output_checks": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check", "passed"],
            "properties": {
              "check": { "type": "string" },
              "passed": { "type": ["boolean", "null"] },
              "detail": { "type": "string" }
            }
          }
        },
        "final_result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["answer_excerpt", "audit_codes", "judgment"],
          "properties": {
            "answer_excerpt": { "type": "string" },
            "citations": { "type": ["integer", "null"] },
            "audit_codes": { "type": "array", "items": { "type": "string" } },
            "judgment": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["task_success", "tool_correct", "number_grounded"],
              "properties": {
                "task_success": { "type": ["boolean", "null"] },
                "tool_correct": { "type": ["boolean", "null"] },
                "number_grounded": { "type": ["boolean", "null"] }
              }
            }
          }
        },
        "cost": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["duration_ms", "prompt_tokens", "completion_tokens"],
          "properties": {
            "duration_ms": { "type": ["integer", "null"] },
            "context_ms": { "type": ["integer", "null"] },
            "llm_ms": { "type": ["integer", "null"] },
            "tool_ms": { "type": ["integer", "null"] },
            "prompt_tokens": { "type": ["integer", "null"] },
            "completion_tokens": { "type": ["integer", "null"] },
            "compression_tokens": { "type": ["integer", "null"] },
            "tokens_estimated": { "type": ["boolean", "null"] }
          }
        }
      }
    }
  }
}
